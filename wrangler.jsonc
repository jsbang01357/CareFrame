{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careframe",
  "account_id": "44dd9bdd72b3e9059e26678dd831e0c0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "careframe.jisong.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://careframe.jisong.dev",
    "EXTRACT_MODEL": "gpt-4.1",
    "REALTIME_MODEL": "gpt-realtime-2.1",
    "REALTIME_TRANSCRIPTION_MODEL": "gpt-4o-mini-transcribe",
    "REALTIME_VOICE": "marin",
    "REALTIME_VOICE_CHEOLSU": "ash",
    "ENABLE_FIXTURES": "false",
    "PROTOCOL_REVIEWED": "false"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
